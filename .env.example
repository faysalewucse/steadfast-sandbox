# Copy this file to .env and fill in your local values.
# `.env` is gitignored — only `.env.example` is committed.

# ---------- Server ----------
# Port the mock listens on.
PORT=3000

# ---------- Webhook delivery ----------
# Where the mock POSTs delivery_status webhooks when a consignment's status
# transitions to one of: pending, delivered, partial_delivered, cancelled, unknown.
# Leave empty to disable webhook firing.
WEBHOOK_URL=http://localhost:8000/api/v1/steadfast/webhook

# Optional bearer token sent in the Authorization header (Bearer <secret>)
# Mirrors Steadfast's "Bearer {your_api_key}" header pattern.
WEBHOOK_SECRET=shared-webhook-secret

# Default value placed in the webhook payload's `delivery_charge` field.
WEBHOOK_DELIVERY_CHARGE=60

# ---------- Status auto-progression ----------
# Time (ms) a new order spends in `in_review` before moving to `pending`.
IN_REVIEW_MS=15000

# Time (ms) an order spends in `pending` before moving to `delivered`.
PENDING_MS=15000

# Background ticker interval (ms). The mock scans all consignments this often
# and advances statuses without requiring a poll, so webhooks fire on time.
# Set to 0 to disable the ticker (status only advances on query).
TICKER_MS=2000
